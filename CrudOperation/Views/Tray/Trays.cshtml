    <script src="~/Asset/js-lib/qz-tray.js"></script>
    }*@
@*@Html.Partial("~/Views/Shared/_JsReportPdfExport.cshtml")
    @section scripts{
        @Scripts.Render("~/bundles/tray-js")
        <script src="~/assets/js-lib/qz-tray.js"></script>
        <script>
            PubSub.subscribe('printbarcode', function (eventData) {
                qz.websocket.connect().then(() => {
                    return qz.printers.find(eventData.printer);
                }).then((found) => {
                    var config = qz.configs.create(found);
                    var printData = eventData.barCodeData.map((data) => {
                        return data.barCodeTemplate
                    });
                    return qz.print(config, printData);
                }).catch((e) => {
                    alert(e);
                }).finally(() => {
                    return qz.websocket.disconnect();
                });
            });
        </script>
    }*@
