@model CrudOperation.Models.Tray.TrayDetailModel
@using CrudOperation.Helper
@{
    ViewBag.Title = Model.Name; 
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@*@section Breadcrumb{<li class="breadcrumb-item"><a href="@Url.Action("Index","Setting")">Settings</a></li><li class="breadcrumb-item"><a href="@Url.Action("Trays","Setting")">Trays</a></li>}
@section BreadcrumbActive {Edit Manage Tray}
@section ngController{ng-controller='trayCtrl as pm'}*@
<div class="container-fluid" ng-controller="trayCtrl as pm">
    <div class="row">
        <div class="col-sm-8 col-12 px-0 px-sm-2 float-left">
            <div class="card card-box p-0">
                <div class="card-header bg-white border-bottom">
                    <div class="row">
                        <div class="col-sm-8 col-12"><h3 class="font-18 font-weight-bold text-dark">Edit Tray</h3></div>
                    </div>
                </div>
                <div class="card-body" ng-init='pm.initTrayDetail(@Html.Json(Model))'>
                    <div class="row">
                        <div class="col-sm-6 col-12 form-group">
                            <div class="form-group">
                                <label class="mr-2">Name<span class="text-danger">*</span></label>
                                <input class="form-control ng-pristine ng-untouched ng-valid" id="ItemText" name="ItemText" ng-model="pm.tray.Name" type="text">
                            </div>
                        </div>
                        <div class="col-sm-6 col-12 form-group">
                            <div class="form-group">
                                <label class="mr-2">Code<span class="text-danger">*</span></label>
                                <input disabled class="form-control ng-pristine ng-untouched ng-valid" id="ItemText" name="ItemText" ng-model="pm.tray.Code" type="text">
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 form-group">
                            <label class="control-label">WareHouse<span class="text-danger">*</span></label>
                            <select ng-model="pm.tray.DeliveryCenterId"
                                    ng-options="w.recordId as w.code for w in pm.warehouses"
                                    class="form-control">
                                <option value="">Select</option>
                            </select>
                        </div>
                        <div class="col-12 col-sm-6 form-group">
                            <label class="d-block">BarCode</label>
                            <img src="data:image/jpeg;base64,{{pm.tray.Base64}}" height="60" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row botton-fixed-bottom">
        <div class="col-sm-12 text-right">
            <a href="@Url.Action("Trays","Setting")" class="btn btn-light">Cancel</a>
            <button type="button" class="btn btn-success" ng-click="pm.updateTray()">Save</button>
        </div>
    </div>
</div>
@*@section scripts{
    @Scripts.Render("~/bundles/tray-js")
}*@
