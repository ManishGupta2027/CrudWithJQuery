@model CrudOperation.Models.DeliveryCenterLocationsModel
@{
    ViewBag.Title = "AddTrayGroup";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>AddTrayGroup</h2>

@*@model  Omnicx.Oms.Web.V3.Models.DeliveryCenterModels.DeliveryCenterLocationsModel
    @{
        ViewBag.Title = "TrayGroups";
        Layout = "~/Views/Shared/_LayoutSetting.cshtml";
    }
    @section Breadcrumb{<li class="breadcrumb-item"><a href="@Url.Action("Index", "Location")">Delivery Centers</a></li><li class="breadcrumb-item"><a href="@Url.Action("Detail", "Location")/@Model.DeliveryCenterId"> @Model.DeliveryCenterName </a></li>}
    @section BreadcrumbActive {
        <a href="@Url.Action("TrayGroups","Tray",new {deliveryCenterId=@Model.DeliveryCenterId})">TrayGroups</a> > TrayGroup}
    @section ngController{ng-controller='trayCtrl as pm'}*@

<div class="container-fluid" ng-controller="trayCtrl as pm">
    <div class="row" ng-init='pm.initTrayGroup("@Model.DeliveryCenterId")'>
        <div class="col-sm-8 col-12 px-0 px-sm-2 float-left">
            <div class="card card-box p-0">
                <div class="card-header bg-white border-bottom">
                    <div class="row">
                        <div class="col-sm-8 col-12">
                            <h3 class="font-18 font-weight-bold text-dark">New TrayGroup</h3>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-6 col-sm-6 col-12 form-group">
                            <div class="form-group">
                                <label class="mr-2">Name<span class="text-danger">*</span></label>
                                <input class="form-control" id="ItemText" name="ItemText" ng-model="pm.trayGroup.Name" type="text">
                            </div>
                        </div>
                        <div class="col-lg-6 col-sm-6 col-12 form-group">
                            <div class="form-group">
                                <label class="mr-2">Capacity<span class="text-danger">*</span></label>
                                <input class="form-control" id="ItemText" name="ItemText" ng-model="pm.trayGroup.Capacity" type="number">
                            </div>
                        </div>
                        <div class="col-10 col-sm-10">
                            <label class="mr-2">Selected Trays<span class="text-danger">*</span></label>
                            <ul class="pt-2 p-0">
                                <li class="badge badge-light  shadow-sm font-13 mr-1" ng-repeat="tray in pm.trayGroup.Trays track by $index">
                                    <span ng-bind="tray.name"></span>
                                    <a href="" class="text-right pl-1 text-dark" ng-click="pm.removeSelectedTray(tray,$index);" data-toggle="tab">&times;</a>
                                </li>
                            </ul>
                            <p class="text-muted mt-2" ng-if="pm.trayGroup.Trays.length === 0">No trays selected.</p>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-12 col-lg-12 px-0 px-sm-2">
                            <div class="card card-box">
                                <form class="row" ng-enter="pm.pageFilter.currentPage=1;pm.getAvailableTrays(pm.pageFilter);">
                                    <div class="col-12 col-sm-3">
                                        @Html.TextBox("Name", "", new { @ng_model = "pm.pageFilter.name", @class = "form-control", @placeholder = "Search Tray" })
                                    </div>
                                    <div class="col-12 col-sm-2">
                                        <button type="button" class="btn btn-primary m--w-100 mb-2 mb-sm-0" ng-click="pm.pageFilter.currentPage=1;pm.getAvailableTrays(pm.pageFilter);">Search </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                        <div class="col-12 col-lg-12 px-0 px-sm-2">
                            <div class="card-box p-0">
                                <div class="row mx-0">
                                    <div class="col-12 col-lg-12 px-0">
                                        <div class="table-responsive">
                                            <table class="table table-centered table-hover mb-0">
                                                <thead class="thead-white">
                                                    <tr>
                                                        <th>Name</th>
                                                        <th class="text-right padding-right-10">Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody ng-repeat="sr in pm.trays track by $index">
                                                    <tr>
                                                        <td><a href="/Tray/Detail/{{sr.recordId}}" class="font-weight-bold font-13" ng-bind="sr.name"></a></td>
                                                        <td align="right">
                                                            <a class="btn btn-outline-secondary btn-xs show-on-hover" ng-click='pm.addTray(sr)'>Add</a>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                    <div class="col-12 col-lg-12" ng-show="pm.trays.length>0">
                                        <div paging
                                             class="small"
                                             page="page"
                                             page-size="pageSize"
                                             total="total"
                                             text-next="next"
                                             text-prev="prev"
                                             show-prev-next="true"
                                             show-first-last="false"
                                             disabled="false"
                                             adjacent="2"
                                             text-next-class="pagination-border-less-next"
                                             text-prev-class="pagination-border-less-prev"
                                             paging-action="pm.pageFilter.currentPage=page;pm.getAvailableTrays(pm.pageFilter);">
                                        </div>
                                    </div>
                                </div>
                                <div class="row" ng-hide="pm.trays.length>0">
                                    <div class="col-sm-12 col-xl-12 p-5 text-center mt-2">
                                        <div class="nodata-order">
                                            <h3 class="mt-3 text-muted">No trays available</h3>
                                        </div>
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row botton-fixed-bottom">
        <div class="col-sm-12 text-right">
            <a href="@Url.Action("Trays","Setting")" class="btn btn-light">Cancel</a>
            <button type="button" class="btn btn-success" ng-click='pm.saveTrayGroup("@Model.DeliveryCenterId")'>Save</button>
        </div>
    </div>
</div>
@*@section scripts{
        @Scripts.Render("~/bundles/tray-js")
    }*@
