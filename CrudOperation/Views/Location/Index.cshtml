@model IEnumerable<CrudOperation.Models.DeliveryCenterDetailModel>
@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>
<div class="row">
    <div class="col-12 col-lg-12 px-0 px-sm-2">
        <div class="card-box border border-light-gray pl-0 pr-0 py-0">
            <div class="row">
                <div class="col-12 col-lg-12">
                    <div class="table-responsive">
                        <table class="table table-centered table-hover mb-0">
                            <thead class="thead-white">
                                <tr>
                                    <th>Code</th>
                                    <th>Name</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var center in Model)
                                {
                                    <tr>
                                        <!-- Corrected: Added link text inside the anchor tag -->
                                        <td><a href="@Url.Action("Detail", "Location", new { id = center.DeliveryCenterId })" class="font-weight-bold">@center.Code</a></td>
                                        <td><span>@center.DeliveryCenterName</span></td>
                                        <td align="right">
                                            <!-- Corrected: Fixed the syntax for query string in Url.Action -->
                                            <a class="btn btn-outline-secondary btn-xs show-on-hover" href="@Url.Action("Index", "DeliveryCenterLocation", new { deliveryCenterId = center.DeliveryCenterId })">
                                                Bin Detail
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
